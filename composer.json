{
  "name": "schnti/boilerplate",
  "description": "schnti's Kirby boilerplate",
  "type": "project",
  "keywords": [
    "kirby",
    "cms",
    "boilerplate"
  ],
  "authors": [
    {
      "name": "Timo Schneider",
      "email": "timo.schneider@mway.io"
    }
  ],
  "require": {
    "php": "^8.2",
    "getkirby/cms": "^5.0",
    "schnti/photoswipe": "^1.0",
    "schnti/cachebuster": "^1.0",
    "schnti/legal": "^1.5",
    "schnti/sitemap": "^2.0",
    "schnti/robots": "^1.0",
    "schnti/umami": "^1.0",
    "medienbaecker/kirby-modules": "^3.0"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/*": true,
      "schnti/*": true
    }
  },
  "extra": {
    "kirby-cms-path": false
  }
}
